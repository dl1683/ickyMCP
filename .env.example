ICKY_EMBEDDING_PROVIDER=voyage
ICKY_VOYAGE_API_KEY=
ICKY_VOYAGE_MODEL=voyage-3.5-lite
ICKY_VOYAGE_DIMENSIONS=1024
ICKY_VOYAGE_WORKERS=8

ICKY_CHUNK_SIZE=5000
ICKY_CHUNK_OVERLAP=500
ICKY_DATA_DIR=./data
ICKY_DB_PATH=./icky_voyage.db

# For offline/local embeddings instead of Voyage:
# ICKY_EMBEDDING_PROVIDER=local
# ICKY_LOCAL_MODEL=nomic-ai/nomic-embed-text-v1.5
